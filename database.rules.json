{
  "rules": {
    "newsPosts": {
      ".read": true,
      ".indexOn": ["createdAt"],
      "$postId": {
        ".write": "auth != null && auth.uid === 'JkKsS2tV4cgAkn9VencX2n59zfb2'",
        ".validate": "newData.hasChildren(['title', 'category', 'summary', 'content', 'imageUrl', 'createdAt', 'authorUid', 'published'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 140"
        },
        "category": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "summary": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 400"
        },
        "content": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20000"
        },
        "imageUrl": {
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "authorUid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "published": {
          ".validate": "newData.val() === true"
        },
        "reviewedBy": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
